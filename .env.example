# ---- Formulário (opcional) ----
# O formulário abre o WhatsApp da Juá. Se quiser também uma cópia por e-mail,
# crie uma conta grátis no Resend (https://resend.com) com o e-mail abaixo e gere uma API key.
RESEND_API_KEY=
# Sem domínio próprio verificado no Resend, use o remetente de teste deles:
CONTACT_FROM="Site Juá <onboarding@resend.dev>"
# Para onde vai a cópia (no plano grátis, precisa ser o e-mail da conta do Resend)
CONTACT_TO=juagency.info@gmail.com

# ---- Endereço do site ----
# Só mude se usar um domínio próprio (ex.: https://juaagency.com.br)
NEXT_PUBLIC_SITE_URL=https://site-jua-agency.vercel.app
